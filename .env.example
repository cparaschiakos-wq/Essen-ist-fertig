# Supabase-Projekt: https://supabase.com/dashboard -> Project Settings -> API
# Region beim Anlegen auf "Central EU (Frankfurt)" stellen.
#
# Wichtig: nur die Basis-Adresse des Projekts, OHNE Pfad. Also
#   https://abcdefgh.supabase.co        richtig
#   https://abcdefgh.supabase.co/rest/v1/   falsch - den Pfad hängt der Client an
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# Der "anon public"-Schlüssel. Er ist für den Browser gedacht und darf dort
# stehen - den Zugriff regeln die Policies in der Datenbank.
# Niemals der service_role- bzw. secret key.
VITE_SUPABASE_ANON_KEY=DEIN-ANON-KEY
